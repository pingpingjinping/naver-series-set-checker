# Discord Developer Portal의 Bot Token
DISCORD_BOT_TOKEN=

# 이 Discord 사용자 ID만 슬래시 명령 실행 허용
DISCORD_ALLOWED_USER_ID=

# 선택 사항. 넣으면 해당 서버에 슬래시 명령이 즉시 동기화됨.
# 비워두면 글로벌 명령으로 등록되며 반영에 시간이 걸릴 수 있음.
DISCORD_GUILD_ID=

# 기존 WalnutPi GitHub 토큰 파일 재사용 (기본값과 같으면 생략 가능)
GITHUB_TOKEN_FILE=/home/pi/.config/naver-series-set-checker/github_token

# 필요하면 토큰 값을 직접 넣어도 됨. 값이 있으면 GITHUB_TOKEN_FILE보다 우선함.
GITHUB_TOKEN=

GITHUB_REPO=pingpingjinping/naver-series-set-checker
GITHUB_BRANCH=main
