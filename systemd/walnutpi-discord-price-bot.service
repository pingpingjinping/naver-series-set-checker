[Unit]
Description=WalnutPi Discord price command bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/.local/share/naver-series-set-checker
EnvironmentFile=/home/pi/.config/naver-series-set-checker/discord-price-bot.env
ExecStart=/home/pi/.local/share/naver-series-set-checker/.venv/bin/python /home/pi/.local/share/naver-series-set-checker/discord_price_bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
